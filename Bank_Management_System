-- create database


create database bank;
use bank;
– create 10 tables

create table customer 
( customerid int primary key ,name varchar(90), 
address varchar(90) ,city varchar(90), state  varchar(90) , 
postalcode int, phone bigint, email varchar(90), 
dateofbirth date, gender varchar(90),occupation varchar(90));


 
create table branch 
( branchid int primary key, branchname varchar(90),location varchar(90), 
managername varchar(90) ,contactnumber bigint, IFSCCode varchar(90));

create table employee
(employeeid  int primary key, name varchar(90), role varchar(90), salary int, 
 hiredate date,email varchar(90), phone bigint,branchid int,  
 foreign key (branchid) references branch(branchid));
 
 
 
 create table account 
 (AccountID int primary key,	AccountType  varchar(90), Balance int, OpenDate date ,
 Status varchar(90), InterestRate varchar(90), Customerid int , branchid int,       
 foreign key (Customerid) references customer (customerid),-- select ballance ,count(*) from account group by  accounttype;
 foreign key (branchid) references branch (branchid));
 
 
 
 create table transaction 
 (tarnsaction int  primary key,date date,amount int, type varchar(90) , description  varchar(900),mode varchar(90),status varchar(90), accountid int,
 foreign key (accountid) references account(accountId)); 

create table loan 
( loanid int primary key, loantype varchar(90), amount int,interestrate int , startdate date , 
enddate date ,status varchar(90), customerid int ,branchid int,
foreign key  (customerid) references customer (customerid),
foreign key (branchid) references branch (branchid));



create table payment
(paymentid int primary key, date date, amount int, mode varchar(90), status varchar(90), 
referencenumber int , loanid int, customerid int,
foreign key (loanid) references loan(loanid),
foreign key (customerid) references customer (customerid));

create table card
(cardid int, cardnumber int, cardtype varchar(90), expirydate date, cvv varchar(90), issuedate date, status varchar(90),
accountid int, 
foreign key (accountid) references account(accountid));

create table login
(loginid int , username varchar(90), password varchar(90), lastlogin varchar(90), securityquestion text, security text,
customerid int,
foreign key (customerid) references customer(customerid));

create table audit_log 
(logid int ,action varchar(90), timestamp int, ipaddress varchar(90), deviceinfo varchar(90), 
employeeid int,
foreign key (employeeid ) references employee(employeeid));
 
 alter table card add  primary key (cardid);
 alter table login add primary key (loginid);
 alter table audit_log add  primary key (logid);

